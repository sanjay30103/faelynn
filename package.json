{
  "name": "faelynn-redesign",
  "version": "1.0.0",
  "private": true,
  "description": "Faelynn e-commerce redesign — PHP + Tailwind CSS (WordPress/WooCommerce theme ready structure)",
  "scripts": {
    "dev": "tailwindcss -i ./assets/css/input.css -o ./assets/css/app.css --watch",
    "build": "tailwindcss -i ./assets/css/input.css -o ./assets/css/app.css --minify",
    "serve": "php -S localhost:8000"
  },
  "devDependencies": {
    "tailwindcss": "3.4.17",
    "@tailwindcss/forms": "0.5.9"
  },
  "dependencies": {
    "swiper": "11.1.15"
  }
}
